<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Electron / JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow unsigned executable memory (Chromium requires this) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Needed for dynamic libraries loaded at runtime (sharp, etc.) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Read/write access to user-selected files (photos & videos) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Network access (for future cloud backup features) -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
